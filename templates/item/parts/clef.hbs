<section class="item-body clef-body{{#unless isEditable}} item-body--readonly{{/unless}}">

  <div class="form-group">
    <label>{{localize "STARMARX.Clef.Fields.ZlotyReward"}}</label>
    <input type="number" name="system.zlotyReward" value="{{system.zlotyReward}}" min="0" max="5">
  </div>

  <div class="form-group">
    <label>{{localize "STARMARX.Sheet.Fields.Description"}}</label>
    <prose-mirror name="system.description" value="{{system.description}}"></prose-mirror>
  </div>

  <div class="form-group">
    <label>{{localize "STARMARX.Clef.Fields.Trigger"}}</label>
    <prose-mirror name="system.trigger" value="{{system.trigger}}"></prose-mirror>
  </div>

  <div class="form-group">
    <label class="checkbox-inline">
      <input type="checkbox" name="system.bonus" {{#if system.bonus}}checked{{/if}}>
      <span>{{localize "STARMARX.Clef.Fields.BonusLabel"}}</span>
    </label>
    <p class="hint">{{localize "STARMARX.Clef.Fields.BonusHint"}}</p>
  </div>

</section>
