<section class="item-body signe-body{{#unless isEditable}} item-body--readonly{{/unless}}">

  <div class="form-group">
    <label>{{localize "STARMARX.Signe.Fields.Category"}}</label>
    <select name="system.category">
      <option value="general"     {{#if (eq system.category "general")}}selected{{/if}}>{{localize "STARMARX.Signe.Category.General"}}</option>
      <option value="trait"       {{#if (eq system.category "trait")}}selected{{/if}}>{{localize "STARMARX.Signe.Category.Trait"}}</option>
      <option value="racial"      {{#if (eq system.category "racial")}}selected{{/if}}>{{localize "STARMARX.Signe.Category.Racial"}}</option>
      <option value="race"        {{#if (eq system.category "race")}}selected{{/if}}>{{localize "STARMARX.Signe.Category.Race"}}</option>
      <option value="groupuscule" {{#if (eq system.category "groupuscule")}}selected{{/if}}>{{localize "STARMARX.Signe.Category.Groupuscule"}}</option>
    </select>
  </div>

  {{#if (eq system.category "trait")}}
    <div class="form-group">
      <label>{{localize "STARMARX.Signe.Fields.TraitLink"}}</label>
      <input type="text" name="system.traitLink" value="{{system.traitLink}}" placeholder="marteau.lutte">
    </div>
  {{/if}}

  {{#if requiresTraitTarget}}
    <div class="form-group">
      <label>{{localize "STARMARX.Signe.Fields.TargetTrait"}}</label>
      <select name="system.targetTrait">
        <option value="">{{localize "STARMARX.Signe.Fields.TargetTraitEmpty"}}</option>
        {{#each targetTraitGroups}}
          <optgroup label="{{localize this.labelKey}}">
            {{#each this.traits}}
              <option value="{{this.value}}" {{#if (eq @root.system.targetTrait this.value)}}selected{{/if}}>
                {{localize this.labelKey}}
              </option>
            {{/each}}
          </optgroup>
        {{/each}}
      </select>
      <p class="hint">{{localize "STARMARX.Signe.Fields.TargetTraitHint"}}</p>
    </div>
  {{/if}}

  {{#if requiresTeamMode}}
    <div class="form-group">
      <label>{{localize "STARMARX.Signe.Fields.TeamMode"}}</label>
      <select name="system.teamMode">
        <option value="group" {{#if (eq system.teamMode "group")}}selected{{/if}}>{{localize "STARMARX.Signe.Fields.TeamModeGroup"}}</option>
        <option value="alone" {{#if (eq system.teamMode "alone")}}selected{{/if}}>{{localize "STARMARX.Signe.Fields.TeamModeAlone"}}</option>
      </select>
      <p class="hint">{{localize "STARMARX.Signe.Fields.TeamModeHint"}}</p>
    </div>
  {{/if}}

  <div class="form-group">
    <label class="checkbox-inline">
      <input type="checkbox" name="system.bonus" {{#if system.bonus}}checked{{/if}}>
      <span>{{localize "STARMARX.Signe.Fields.BonusLabel"}}</span>
    </label>
    <p class="hint">{{localize "STARMARX.Signe.Fields.BonusHint"}}</p>
  </div>

  <div class="form-group">
    <label>{{localize "STARMARX.Sheet.Fields.Description"}}</label>
    <prose-mirror name="system.description" value="{{system.description}}"></prose-mirror>
  </div>

</section>
