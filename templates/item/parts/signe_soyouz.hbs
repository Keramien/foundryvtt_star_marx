<section class="item-body item-body--soyouz signe-soyouz-body">

  <div class="soyouz-banner">
    <i class="fa-solid fa-rocket"></i>
    <span>{{localize "STARMARX.SigneSoyouz.Banner"}}</span>
  </div>

  <div class="form-group">
    <label>{{localize "STARMARX.SigneSoyouz.Fields.Tag"}}</label>
    <input type="text" name="system.tag" value="{{system.tag}}"
           placeholder="{{localize 'STARMARX.SigneSoyouz.Fields.TagPlaceholder'}}">
    <p class="hint">{{localize "STARMARX.SigneSoyouz.Fields.TagHint"}}</p>
  </div>

  <div class="form-group">
    <label>{{localize "STARMARX.Sheet.Fields.Description"}}</label>
    <prose-mirror name="system.description" value="{{system.description}}"></prose-mirror>
  </div>

</section>
