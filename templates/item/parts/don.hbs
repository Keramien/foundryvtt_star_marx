<section class="item-body don-body{{#unless isEditable}} item-body--readonly{{/unless}}">

  <p class="hint">{{localize "STARMARX.Don.Hint"}}</p>

  <div class="form-group">
    <label>{{localize "STARMARX.Don.Fields.Alias"}}</label>
    <input type="text" name="system.alias" value="{{system.alias}}">
  </div>

  <div class="form-group">
    <label>{{localize "STARMARX.Don.Fields.Rank"}}</label>
    <input type="number" name="system.rank" value="{{system.rank}}" min="1" max="3">
  </div>

  <div class="form-group">
    <label>{{localize "STARMARX.Sheet.Fields.Description"}}</label>
    <prose-mirror name="system.description" value="{{system.description}}"></prose-mirror>
  </div>

</section>
