<section class="tab {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  <div class="trait-points-banner soyouz-total-banner {{#unless traitTotalBalanced}}soyouz-total-banner--off{{/unless}}">
    <div class="pts-value">
      <span class="pts-available">{{traitTotal}}</span>
    </div>
    <div class="pts-label">
      <strong>{{localize "STARMARX.Soyouz.Fields.TraitTotal"}}</strong>
      <small>{{localize "STARMARX.Soyouz.Fields.TraitTotalHint"}}</small>
    </div>
    <div class="pts-spent">
      <button type="button" class="pts-reset" data-action="resetTraits"
              title="{{localize 'STARMARX.Soyouz.Action.ResetTraitsHint'}}">
        <i class="fa-solid fa-rotate-left"></i>
      </button>
    </div>
  </div>

  <div class="doctrine-group soyouz-trait-group">
    <header class="doctrine-header">
      <h2>{{localize "STARMARX.Soyouz.Sections.Traits"}}</h2>
    </header>
    <ul class="trait-list">
      {{#each traits}}
        <li class="trait-row soyouz-trait-row">
          <label class="trait-name">{{localize this.labelKey}}</label>
          <button type="button" class="trait-btn trait-roll"
                  data-action="rollTrait"
                  data-trait="{{this.id}}"
                  title="{{localize 'STARMARX.Sheet.Action.RollTrait'}}">
            <i class="fa-solid fa-dice-d6"></i>
          </button>
          <button type="button" class="trait-btn trait-help"
                  data-action="helpTrait"
                  data-trait="{{this.id}}"
                  title="{{localize 'STARMARX.Sheet.Action.HelpTrait'}}">
            <i class="fa-solid fa-hand"></i>
          </button>
          <input class="trait-field trait-points"
                 type="number"
                 name="{{this.scorePath}}"
                 value="{{this.score}}"
                 step="1"
                 title="{{localize 'STARMARX.Soyouz.Fields.Score'}}">
          <span class="trait-op">+</span>
          <input class="trait-field trait-bonus"
                 type="number"
                 name="{{this.bonusPath}}"
                 value="{{#if this.bonus}}{{this.bonus}}{{/if}}"
                 placeholder="{{localize 'STARMARX.Soyouz.Fields.BonusPlaceholder'}}"
                 title="{{localize 'STARMARX.Soyouz.Fields.Bonus'}}">
          <span class="trait-op">+</span>
          <input class="trait-field trait-avaries"
                 type="number"
                 name="{{this.avariesPath}}"
                 value="{{#if this.avaries}}{{this.avaries}}{{/if}}"
                 placeholder="{{localize 'STARMARX.Soyouz.Fields.AvariesPlaceholder'}}"
                 title="{{localize 'STARMARX.Soyouz.Fields.Avaries'}}">
          <span class="trait-op">=</span>
          <span class="trait-total" title="{{localize 'STARMARX.Soyouz.Fields.Total'}}">{{this.total}}</span>
        </li>
      {{/each}}
    </ul>
  </div>

</section>
