<section class="tab {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  <div class="equip-block barda-block">
    <header class="equip-block__header">
      <h2>{{localize "STARMARX.Soyouz.Sections.Soute"}}</h2>
      <div class="counter">{{bardas.length}}</div>
      <button type="button" class="add-btn" data-action="itemCreate" data-item-type="barda">
        <i class="fa-solid fa-plus"></i> {{localize "STARMARX.Sheet.Action.AddBarda"}}
      </button>
    </header>
    {{#if bardas.length}}
      <ul class="item-list barda-list">
        {{#each bardas}}
          <li class="item-row" data-item-id="{{this.id}}">
            <img class="item-img" src="{{this.img}}" alt="">
            <div class="item-body">
              <h4 class="item-name">
                {{this.name}}
                {{#if this.system.source}}<span class="tag">{{this.system.source}}</span>{{/if}}
              </h4>
            </div>
            <div class="item-actions">
              <button type="button" data-action="itemEdit"><i class="fa-solid fa-pen"></i></button>
              <button type="button" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
            </div>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <div class="drop-zone">
        <i class="fa-solid fa-box-archive"></i>
        <p>{{localize "STARMARX.Soyouz.Action.DropBardaHere"}}</p>
      </div>
    {{/if}}
  </div>

</section>
