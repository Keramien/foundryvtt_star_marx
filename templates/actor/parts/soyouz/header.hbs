<header class="kamarade-header soyouz-header">
  <img class="kamarade-avatar" src="{{actor.img}}" data-edit="img" data-action="editImage"
       title="{{localize 'STARMARX.ImagePicker.Change'}}" alt="{{actor.name}}">
  <div class="kamarade-header__titles">
    <input type="text" name="name" value="{{actor.name}}"
           placeholder="{{localize 'STARMARX.Soyouz.NamePlaceholder'}}" class="charname">
  </div>
</header>
