<section class="tab {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  <div class="stats-row">
    <div class="stat-block stat-hp">
      <h3>{{localize "STARMARX.Actor.Health.Label"}}</h3>
      <div class="stat-values">
        <input type="number" data-health-value value="{{system.health.value}}" min="0" max="{{system.health.max}}">
        <span class="sep">/</span>
        <span class="stat-max">{{system.health.max}}</span>
      </div>
      <p class="hint">{{localize "STARMARX.Soyouz.Fields.HealthFormula"}}</p>
    </div>

    <div class="stat-block stat-damage">
      <h3>{{localize "STARMARX.Soyouz.Fields.Damage"}}</h3>
      <div class="stat-values">
        <span class="stat-readout">{{damageFromOrgue}}</span>
      </div>
      <p class="hint">{{localize "STARMARX.Soyouz.Fields.DamageHint"}}</p>
    </div>

    <div class="stat-block stat-trait-total {{#unless traitTotalBalanced}}stat-trait-total--off{{/unless}}">
      <h3>{{localize "STARMARX.Soyouz.Fields.TraitTotal"}}</h3>
      <div class="stat-values">
        <span class="stat-readout">{{traitTotal}}</span>
      </div>
      <p class="hint">{{localize "STARMARX.Soyouz.Fields.TraitTotalHint"}}</p>
    </div>
  </div>

  <div class="narrative-block">
    <h3>{{localize "STARMARX.Sheet.Fields.Description"}}</h3>
    <prose-mirror name="system.details.description" value="{{system.details.description}}"></prose-mirror>
  </div>

  <div class="narrative-block">
    <h3>{{localize "STARMARX.Actor.Details.Notes"}}</h3>
    <prose-mirror name="system.details.notes" value="{{system.details.notes}}"></prose-mirror>
  </div>

</section>
