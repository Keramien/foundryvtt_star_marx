<section class="tab {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  <div class="signe-block signe-racial">
    <header class="signe-block__header">
      <h2>{{localize "STARMARX.Sheet.Sections.SigneRacial"}}</h2>
    </header>
    {{#if signes.racial}}
      <div class="item-row" data-item-id="{{signes.racial.id}}">
        <img class="item-img" src="{{signes.racial.img}}" alt="">
        <div class="item-body">
          <h4 class="item-name">{{signes.racial.name}}</h4>
          <div class="item-desc">{{{signes.racial.system.description}}}</div>
        </div>
        <div class="item-actions">
          <button type="button" data-action="itemEdit" title="{{localize 'STARMARX.Sheet.Action.Edit'}}"><i class="fa-solid fa-pen"></i></button>
          <button type="button" data-action="itemDelete" title="{{localize 'STARMARX.Sheet.Action.Delete'}}"><i class="fa-solid fa-trash"></i></button>
        </div>
      </div>
    {{else}}
      <p class="empty">{{localize "STARMARX.Sheet.Sections.SigneRacialVide"}}</p>
    {{/if}}
  </div>

  <div class="signe-block signe-generaux">
    <header class="signe-block__header">
      <h2>{{localize "STARMARX.Sheet.Sections.SignesGeneraux"}}</h2>
      <div class="counter">{{signes.generaux.length}} / {{system.limits.signes}}</div>
      <button type="button" class="add-btn" data-action="itemCreate" data-item-type="signe">
        <i class="fa-solid fa-plus"></i> {{localize "STARMARX.Sheet.Action.AddSigne"}}
      </button>
    </header>
    <ul class="item-list">
      {{#each signes.generaux}}
        <li class="item-row" data-item-id="{{this.id}}">
          <img class="item-img" src="{{this.img}}" alt="">
          <div class="item-body">
            <h4 class="item-name">{{this.name}}</h4>
            <div class="item-desc">{{{this.system.description}}}</div>
          </div>
          <div class="item-actions">
            <button type="button" data-action="itemEdit"><i class="fa-solid fa-pen"></i></button>
            <button type="button" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
          </div>
        </li>
      {{/each}}
    </ul>
  </div>

</section>
