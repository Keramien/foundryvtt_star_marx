<section class="tab {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  <div class="signe-block signe-raciaux">
    <header class="signe-block__header">
      <h2>{{localize "STARMARX.Sheet.Sections.SignesRaciaux"}}</h2>
      <div class="counter">{{signes.raciaux.length}}</div>
    </header>
    {{#if signes.raciaux.length}}
      <ul class="item-list">
        {{#each signes.raciaux}}
          <li class="item-row" data-item-id="{{this.id}}">
            <img class="item-img" src="{{this.img}}" alt="">
            <div class="item-body">
              <h4 class="item-name">{{this.name}}</h4>
              <div class="item-desc">{{{this.system.description}}}</div>
            </div>
            <div class="item-actions">
              <button type="button" data-action="itemEdit" title="{{localize 'STARMARX.Sheet.Action.Edit'}}"><i class="fa-solid fa-pen"></i></button>
            </div>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="empty">{{localize "STARMARX.Sheet.Sections.SignesRaciauxVide"}}</p>
    {{/if}}
  </div>

  <div class="signe-block signe-generaux">
    <header class="signe-block__header">
      <h2>{{localize "STARMARX.Sheet.Sections.SignesGeneraux"}}</h2>
      <div class="counter">{{signes.generaux.length}} / {{signesMax}}</div>
      <button type="button" class="add-btn" data-action="itemCreate" data-item-type="signe">
        <i class="fa-solid fa-plus"></i> {{localize "STARMARX.Sheet.Action.AddSigne"}}
      </button>
      <button type="button" class="compendium-btn" data-action="openCompendium" data-pack="signes" title="{{localize 'STARMARX.Sheet.Action.OpenSignesCompendium'}}">
        <i class="fa-solid fa-folder-open"></i>
      </button>
    </header>
    {{#if signes.generaux.length}}
      <ul class="item-list">
        {{#each signes.generaux}}
          <li class="item-row" data-item-id="{{this.id}}">
            <img class="item-img" src="{{this.img}}" alt="">
            <div class="item-body">
              <h4 class="item-name">{{this.name}}</h4>
              <div class="item-desc">{{{this.system.description}}}</div>
            </div>
            <div class="item-actions">
              <button type="button" data-action="itemEdit"><i class="fa-solid fa-pen"></i></button>
              <button type="button" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
            </div>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <div class="drop-zone">
        <i class="fa-solid fa-star"></i>
        <p>{{localize "STARMARX.Sheet.Action.DropSigneHere"}}</p>
      </div>
    {{/if}}
  </div>

  <div class="signe-block signe-bonus">
    <header class="signe-block__header">
      <h2>{{localize "STARMARX.Sheet.Sections.SignesBonus"}}</h2>
      <div class="counter">{{signes.bonus.length}}</div>
      <button type="button" class="add-btn" data-action="itemCreateBonus" data-item-type="signe">
        <i class="fa-solid fa-plus"></i> {{localize "STARMARX.Sheet.Action.AddSigneBonus"}}
      </button>
      <button type="button" class="compendium-btn" data-action="openCompendium" data-pack="signes" title="{{localize 'STARMARX.Sheet.Action.OpenSignesCompendium'}}">
        <i class="fa-solid fa-folder-open"></i>
      </button>
    </header>
    {{#if signes.bonus.length}}
      <ul class="item-list">
        {{#each signes.bonus}}
          <li class="item-row" data-item-id="{{this.id}}">
            <img class="item-img" src="{{this.img}}" alt="">
            <div class="item-body">
              <h4 class="item-name">
                {{this.name}}
                <span class="badge">{{localize "STARMARX.Signe.Fields.Bonus"}}</span>
              </h4>
              <div class="item-desc">{{{this.system.description}}}</div>
            </div>
            <div class="item-actions">
              <button type="button" data-action="itemEdit"><i class="fa-solid fa-pen"></i></button>
              <button type="button" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
            </div>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="empty">{{localize "STARMARX.Sheet.Sections.SignesBonusVide"}}</p>
    {{/if}}
  </div>

</section>
