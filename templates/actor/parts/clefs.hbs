<section class="tab {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  <div class="clef-block clef-raciales">
    <header class="clef-block__header">
      <h2>{{localize "STARMARX.Sheet.Sections.ClefsRaciales"}}</h2>
      <div class="counter">{{clefs.raciales.length}}</div>
    </header>

    {{#if clefs.raciales.length}}
      <ul class="item-list">
        {{#each clefs.raciales}}
          <li class="item-row" data-item-id="{{this.id}}">
            <img class="item-img" src="{{this.img}}" alt="">
            <div class="item-body">
              <h4 class="item-name">
                {{this.name}}
                <span class="badge badge--racial">{{localize "STARMARX.Clef.Racial"}}</span>
              </h4>
              <div class="item-desc">{{{this.system.description}}}</div>
              {{#if this.system.trigger}}
                <div class="clef-trigger">
                  <strong>{{localize "STARMARX.Clef.Fields.Trigger"}} :</strong>
                  <span>{{{this.system.trigger}}}</span>
                </div>
              {{/if}}
              <div class="clef-reward">
                <i class="fa-solid fa-coins"></i>
                {{this.system.zlotyReward}} {{localize "STARMARX.Actor.Zlotys.Label"}}
              </div>
            </div>
            <div class="item-actions">
              <button type="button" data-action="itemEdit" title="{{localize 'STARMARX.Sheet.Action.Edit'}}"><i class="fa-solid fa-pen"></i></button>
            </div>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="empty">{{localize "STARMARX.Sheet.Sections.ClefsRacialesVide"}}</p>
    {{/if}}
  </div>

  <div class="clef-block clef-generales">
    <header class="clef-block__header">
      <h2>{{localize "STARMARX.Sheet.Sections.Clefs"}}</h2>
      <div class="counter">{{clefs.generales.length}} / {{clefsMax}}</div>
      <button type="button" class="add-btn" data-action="itemCreate" data-item-type="clef">
        <i class="fa-solid fa-plus"></i> {{localize "STARMARX.Sheet.Action.AddClef"}}
      </button>
      <button type="button" class="compendium-btn" data-action="openCompendium" data-pack="clefs" title="{{localize 'STARMARX.Sheet.Action.OpenClefsCompendium'}}">
        <i class="fa-solid fa-folder-open"></i>
      </button>
    </header>

    {{#if clefs.generales.length}}
      <ul class="item-list">
        {{#each clefs.generales}}
          <li class="item-row" data-item-id="{{this.id}}">
            <img class="item-img" src="{{this.img}}" alt="">
            <div class="item-body">
              <h4 class="item-name">
                {{this.name}}
                {{#if this.flags.starmarx.racialOnly}}
                  <span class="badge badge--racial">{{localize "STARMARX.Clef.RaceLinked"}}</span>
                {{/if}}
              </h4>
              <div class="item-desc">{{{this.system.description}}}</div>
              {{#if this.system.trigger}}
                <div class="clef-trigger">
                  <strong>{{localize "STARMARX.Clef.Fields.Trigger"}} :</strong>
                  <span>{{{this.system.trigger}}}</span>
                </div>
              {{/if}}
              <div class="clef-reward">
                <i class="fa-solid fa-coins"></i>
                {{this.system.zlotyReward}} {{localize "STARMARX.Actor.Zlotys.Label"}}
              </div>
            </div>
            <div class="item-actions">
              <button type="button" data-action="itemEdit"><i class="fa-solid fa-pen"></i></button>
              <button type="button" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
            </div>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <div class="drop-zone">
        <i class="fa-solid fa-key"></i>
        <p>{{localize "STARMARX.Sheet.Action.DropClefHere"}}</p>
      </div>
    {{/if}}
  </div>

  <div class="clef-block clef-bonus">
    <header class="clef-block__header">
      <h2>{{localize "STARMARX.Sheet.Sections.ClefsBonus"}}</h2>
      <div class="counter">{{clefs.bonus.length}}</div>
      <button type="button" class="add-btn" data-action="itemCreateBonus" data-item-type="clef">
        <i class="fa-solid fa-plus"></i> {{localize "STARMARX.Sheet.Action.AddClefBonus"}}
      </button>
      <button type="button" class="compendium-btn" data-action="openCompendium" data-pack="clefs" title="{{localize 'STARMARX.Sheet.Action.OpenClefsCompendium'}}">
        <i class="fa-solid fa-folder-open"></i>
      </button>
    </header>

    {{#if clefs.bonus.length}}
      <ul class="item-list">
        {{#each clefs.bonus}}
          <li class="item-row" data-item-id="{{this.id}}">
            <img class="item-img" src="{{this.img}}" alt="">
            <div class="item-body">
              <h4 class="item-name">
                {{this.name}}
                <span class="badge">{{localize "STARMARX.Clef.Fields.Bonus"}}</span>
              </h4>
              <div class="item-desc">{{{this.system.description}}}</div>
              {{#if this.system.trigger}}
                <div class="clef-trigger">
                  <strong>{{localize "STARMARX.Clef.Fields.Trigger"}} :</strong>
                  <span>{{{this.system.trigger}}}</span>
                </div>
              {{/if}}
              <div class="clef-reward">
                <i class="fa-solid fa-coins"></i>
                {{this.system.zlotyReward}} {{localize "STARMARX.Actor.Zlotys.Label"}}
              </div>
            </div>
            <div class="item-actions">
              <button type="button" data-action="itemEdit"><i class="fa-solid fa-pen"></i></button>
              <button type="button" data-action="itemDelete"><i class="fa-solid fa-trash"></i></button>
            </div>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="empty">{{localize "STARMARX.Sheet.Sections.ClefsBonusVide"}}</p>
    {{/if}}
  </div>

</section>
