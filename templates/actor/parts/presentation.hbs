<section class="tab {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  <div class="stats-row">
    <div class="stat-block stat-hp">
      <h3>{{localize "STARMARX.Actor.Health.Label"}}</h3>
      <div class="stat-values">
        <input type="number" data-health-value value="{{system.health.value}}" min="0" max="{{system.health.max}}">
        <span class="sep">/</span>
        <span class="stat-max">{{system.health.max}}</span>
      </div>
      <p class="hint">{{localize "STARMARX.Actor.Health.Formula"}}</p>
    </div>

    <div class="stat-block stat-damage">
      <h3>{{localize "STARMARX.Actor.Damage.Label"}}</h3>
      <div class="damage-sources">
        <div><span>{{localize "STARMARX.Actor.Damage.Sources.Lutte"}}</span> <strong>{{system.damage.lutte.value}}</strong></div>
        <div><span>{{localize "STARMARX.Actor.Damage.Sources.Ak47"}}</span> <strong>{{system.damage.ak47.value}}</strong></div>
      </div>
    </div>

    <div class="stat-block stat-zlotys">
      <h3>{{localize "STARMARX.Actor.Zlotys.Label"}}</h3>
      <input type="number" data-zlotys-value value="{{system.zlotys.value}}" min="0">
    </div>
  </div>

  <div class="stat-block stat-xp stat-xp--full">
    <h3>{{localize "STARMARX.Actor.Details.Xp"}}</h3>
    <div class="xp-breakdown">
      <label>
        <span>{{localize "STARMARX.Actor.Details.XpTraits"}}</span>
        <input type="number" name="system.details.xp.traits" value="{{system.details.xp.traits}}" min="0">
      </label>
      <label>
        <span>{{localize "STARMARX.Actor.Details.XpSignes"}}</span>
        <input type="number" name="system.details.xp.signes" value="{{system.details.xp.signes}}" min="0">
      </label>
      <label>
        <span>{{localize "STARMARX.Actor.Details.XpClefs"}}</span>
        <input type="number" name="system.details.xp.clefs" value="{{system.details.xp.clefs}}" min="0">
      </label>
      <label>
        <span>{{localize "STARMARX.Actor.Details.XpAutres"}}</span>
        <input type="number" name="system.details.xp.autres" value="{{system.details.xp.autres}}" min="0">
      </label>
      <div class="xp-total">
        {{localize "STARMARX.Actor.Details.XpTotal"}} <strong>{{system.details.xp.total}}</strong>
      </div>
    </div>
  </div>

  <div class="identity-row">
    <label>
      <span>{{localize "STARMARX.Actor.Details.Sexe"}}</span>
      <input type="text" name="system.details.sexe" value="{{system.details.sexe}}">
    </label>
    <label>
      <span>{{localize "STARMARX.Actor.Details.Age"}}</span>
      <input type="number" name="system.details.age" value="{{system.details.age}}" min="0">
    </label>
    <label>
      <span>{{localize "STARMARX.Actor.Details.Groupuscule"}}</span>
      <input type="text" name="system.details.groupuscule" value="{{system.details.groupuscule}}">
    </label>
  </div>

  <div class="race-block">
    <header class="race-block__header">
      <h3>{{localize "STARMARX.Sheet.Sections.Race"}}</h3>
    </header>
    {{#if race}}
      <div class="item-row" data-item-id="{{race.id}}">
        <img class="item-img" src="{{race.img}}" alt="">
        <div class="item-body">
          <h4 class="item-name">
            {{race.name}}
            {{#if doctrineMismatch}}
              <span class="badge badge--warning" title="{{localize 'STARMARX.Race.DoctrineMismatch.Hint'}}">
                <i class="fa-solid fa-triangle-exclamation"></i>
                {{localize "STARMARX.Race.DoctrineMismatch.Label"}}
              </span>
            {{/if}}
          </h4>
          <div class="item-desc">{{{race.system.description}}}</div>
          {{#if race.system.restrictions}}
            <details class="race-restrictions">
              <summary>{{localize "STARMARX.Race.Fields.Restrictions"}}</summary>
              <div>{{{race.system.restrictions}}}</div>
            </details>
          {{/if}}
        </div>
        <div class="item-actions">
          <button type="button" data-action="itemEdit" title="{{localize 'STARMARX.Sheet.Action.Edit'}}"><i class="fa-solid fa-pen"></i></button>
          <button type="button" data-action="itemDelete" title="{{localize 'STARMARX.Sheet.Action.Delete'}}"><i class="fa-solid fa-trash"></i></button>
        </div>
      </div>
    {{else}}
      <div class="drop-zone">
        <i class="fa-solid fa-people-group"></i>
        <p>{{localize "STARMARX.Sheet.Sections.RaceVide"}}</p>
      </div>
    {{/if}}
  </div>

  <div class="narrative-block">
    <h3>{{localize "STARMARX.Actor.Details.Historique"}}</h3>
    <textarea name="system.details.historique" rows="4">{{system.details.historique}}</textarea>
  </div>

  <div class="narrative-block">
    <h3>{{localize "STARMARX.Actor.Details.Secret"}}</h3>
    <textarea name="system.details.secret" rows="3">{{system.details.secret}}</textarea>
  </div>

  <div class="narrative-block">
    <h3>{{localize "STARMARX.Actor.Details.Manie"}}</h3>
    <textarea name="system.details.manie" rows="3">{{system.details.manie}}</textarea>
  </div>

</section>
